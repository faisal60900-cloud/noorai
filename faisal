  french:  ["Bonjour=مرحبا, Merci=شكراً, Oui=نعم, Non=لا\n\nComment dit-on 'شكراً جزيلاً'?\nHint: Merci ...", "Les nombres: un=1, deux=2, trois=3, quatre=4, cinq=5\nComment dit-on 6,7,8 en français?", "Je m'appelle ... = اسمي ...\nJ'ai ... ans = عمري ...\nPrésente-toi en français!"],
  quran:   ["مخارج الحروف الحلقية:\nأ،ه — من أقصى الحلق\nع،ح — من وسطه\nغ،خ — من أدناه\n\nانطق: اللهُ — رَحمن — حَكيم", "أحكام النون الساكنة:\nإظهار: قبل حروف الحلق\nإدغام: قبل ي,ر,م,ل,و,ن\nإخفاء: قبل باقي الحروف\n\nأين النون في: مَن يَعمل؟", "سورة الفاتحة — أم الكتاب\n7 آيات — مكية\nتُقرأ في كل ركعة\n\nهل تحفظها كاملة؟ أتلها عليّ!"]
};

function getReply(subj) {
  const r = REPLIES[subj] || REPLIES.english;
  return r[chatTurn % r.length];
}

// ── شات ─────────────────────────────────────────────────────
function startChat(subj, name, avatar, color) {
  chatTurn = 0; chatSubjectId = subj; chatColor = color;
  document.getElementById('chatAvatar').textContent = avatar;
  document.getElementById('chatAvatar').style.borderColor = color;
  document.getElementById('chatAvatar').style.background = color+'22';
  document.getElementById('chatName').textContent = name;
  document.getElementById('chatSubject').textContent = 'درس تفاعلي مباشر';
  document.getElementById('chatMessages').innerHTML = '';
  document.getElementById('chatOverlay').classList.add('open');
  addMsg('ai', GREETINGS[subj] || GREETINGS.english);
  document.getElementById('chatInput').style.borderColor = color+'50';
  document.querySelector('.send-btn').style.background = `linear-gradient(135deg,${color},${color}99)`;
}

function closeChat() { document.getElementById('chatOverlay').classList.remove('open'); }

function addMsg(from, text) {
  const box = document.getElementById('chatMessages');
  const div = document.createElement('div');
  div.className = 'msg ' + from;
  div.innerHTML = `<div class="msg-bubble">${text}</div>`;
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
}

function sendMsg() {
  const inp = document.getElementById('chatInput');
  const txt = inp.value.trim();
  if (!txt) return;
  addMsg('user', txt);
  inp.value = ''; inp.style.height = 'auto';

  // typing indicator
  const box = document.getElementById('chatMessages');
  const typing = document.createElement('div');
  typing.className = 'msg ai'; typing.id = 'typing';
  typing.innerHTML = `<div class="typing"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>`;
  box.appendChild(typing);
  box.scrollTop = box.scrollHeight;

  setTimeout(() => {
    document.getElementById('typing')?.remove();
    addMsg('ai', getReply(chatSubjectId));
    chatTurn++;
  }, 1400);
}

// ── تسجيل ───────────────────────────────────────────────────
let regStep = 1, regData = {};

function openRegister() {
  regStep = 1; regData = {};
  document.getElementById('registerModal').classList.add('open');
  renderReg();
}

function closeRegister() { document.getElementById('registerModal').classList.remove('open'); }

function renderReg() {
  const pct = regStep===1?'33%':regStep===2?'66%':'100%';
  let html = `
    <div style="text-align:center;margin-bottom:22px">
      <div style="font-size:30px;margin-bottom:8px">🎓</div>
      <h2 class="modal-title">إنشاء حساب جديد</h2>
      <p class="modal-sub">الخطوة ${regStep} من 3</p>
    </div>
    <div class="progress-bar"><div class="progress-fill" style="width:${pct}"></div></div>
    <div id="regErr"></div>`;

  if(regStep===1) html += `
    <label class="form-label">الاسم الكامل <span style="color:#EF4444">*</span></label>
    <input class="form-input" id="r_name" placeholder="محمد أحمد" value="${regData.name||''}">
    <label class="form-label">البريد الإلكتروني <span style="color:#EF4444">*</span></label>
    <input class="form-input" id="r_email" type="email" placeholder="example@mail.com" value="${regData.email||''}">
    <label class="form-label">كلمة المرور <span style="color:#EF4444">*</span></label>
    <input class="form-input" id="r_pass" type="password" placeholder="6 أحرف على الأقل">
    <button class="btn-submit" onclick="regNext()">التالي ←</button>
    <button class="btn-back" onclick="closeRegister()">إلغاء</button>`;

  else if(regStep===2) html += `
    <label class="form-label">الدولة <span style="color:#EF4444">*</span></label>
    <select class="form-select" id="r_country">
      <option value="">— اختر —</option>
      ${['🇮🇶 العراق','🇸🇦 السعودية','🇦🇪 الإمارات','🇰🇼 الكويت','🇶🇦 قطر','🇧🇭 البحرين','🇴🇲 عمان','🇾🇪 اليمن','🇯🇴 الأردن','🇪🇬 مصر','🇲🇦 المغرب','🌍 أخرى'].map(c=>`<option value="${c}" ${regData.country===c?'selected':''}>${c}</option>`).join('')}
    </select>
    <label class="form-label">العمر <span style="color:#EF4444">*</span></label>
    <input class="form-input" id="r_age" type="number" placeholder="مثال: 20" value="${regData.age||''}">
    <button class="btn-submit" onclick="regNext()">التالي ←</button>
    <button class="btn-back" onclick="{regStep=1;renderReg()}">← رجوع</button>`;

  else html += `
    <label class="form-label">اختر خطتك <span style="color:#EF4444">*</span></label>
    ${[{id:'free',name:'مجاني',price:'مجاناً',c:'#6b7280'},{id:'pro',name:'Pro',price:'3.5 دينار/شهر',c:'#3B82F6'},{id:'family',name:'عائلي',price:'8 دينار/شهر',c:'#D4A843'}].map(p=>`
    <div class="plan-option" style="background:${regData.plan===p.id?p.c+'18':'#1A1A2E'};border:1.5px solid ${regData.plan===p.id?p.c:p.c+'25'}" onclick="regData.plan='${p.id}';renderReg()">
      <div class="plan-radio" style="border-color:${p.c};background:${regData.plan===p.id?p.c:'transparent'}"></div>
      <div style="flex:1"><span style="font-weight:700;color:#fff">${p.name}</span> <span style="font-size:11px;color:#5a5a7a">— ${p.price}</span></div>
    </div>`).join('')}
    <button class="btn-submit" onclick="regSubmit()" style="margin-top:8px">✅ أرسل طلب التسجيل</button>
    <button class="btn-back" onclick="{regStep=2;renderReg()}">← رجوع</button>`;

  document.getElementById('regContent').innerHTML = html;
  if(!regData.plan) regData.plan = 'free';
}

function showRegErr(msg) {
  document.getElementById('regErr').innerHTML = `<div class="error-box">⚠️ ${msg}</div>`;
}

function regNext() {
  if(regStep===1) {
    const name=document.getElementById('r_name').value.trim();
    const email=document.getElementById('r_email').value.trim();
    const pass=document.getElementById('r_pass').value;
    if(!name){showRegErr('أدخل اسمك');return;}
    if(!email.includes('@')){showRegErr('بريد غير صحيح');return;}
    if(pass.length<6){showRegErr('كلمة المرور قصيرة');return;}
    regData={...regData,name,email,pass};
  } else {
    const country=document.getElementById('r_country').value;
    const age=document.getElementById('r_age').value;
    if(!country){showRegErr('اختر دولتك');return;}
    if(!age||isNaN(age)){showRegErr('أدخل عمراً صحيحاً');return;}
    regData={...regData,country,age};
  }
  regStep++; renderReg();
}

function regSubmit() {
  const u = { id:Date.now(), name:regData.name, email:regData.email, country:regData.country, age:regData.age, plan:regData.plan, status:'pending', date:new Date().toLocaleDateString('ar') };
  users.push(u); saveUsers();
  document.getElementById('regContent').innerHTML = `
    <div class="success-screen">
      <div class="success-icon">🎉</div>
      <h2 style="color:#fff;margin:0 0 12px">تم إرسال طلبك!</h2>
      <p style="color:#7070a0;line-height:1.8;margin:0 0 20px">طلبك قيد المراجعة من المشرف. ستُفعَّل حسابك بعد الموافقة.</p>
      <div style="background:#F59E0B15;border:1px solid #F59E0B40;border-radius:14px;padding:12px;color:#F59E0B;font-size:13px;margin-bottom:20px">⏳ عادةً يتم القبول خلال 24 ساعة</div>
      <button class="btn-submit" onclick="closeRegister();updateCount()">← العودة للموقع</button>
    </div>`;
}

// ── أدمن ─────────────────────────────────────────────────────
let adminAuth = false, adminView = 'dashboard', selUser = null;

function openAdmin() { document.getElementById('adminModal').classList.add('open'); renderAdmin(); }
function closeAdmin() { document.getElementById('adminModal').classList.remove('open'); adminAuth=false; adminView='dashboard'; }

function renderAdmin() {
  if(!adminAuth){ renderAdminLogin(); return; }
  if(selUser){ renderUserDetail(); return; }
  if(adminView==='dashboard') renderDashboard();
  else renderUsersList();
}

function renderAdminLogin() {
  document.getElementById('adminContent').innerHTML = `
    <div style="text-align:center;margin-bottom:22px">
      <div style="font-size:36px;margin-bottom:8px">🔐</div>
      <h2 class="modal-title">دخول المشرف</h2>
      <p class="modal-sub">هذه اللوحة للمالك فقط</p>
    </div>
    <div id="adminErr"></div>
    <label class="form-label">البريد الإلكتروني</label>
    <input class="form-input" id="a_email" type="email" placeholder="بريدك">
    <label class="form-label">كلمة المرور</label>
    <input class="form-input" id="a_pass" type="password" placeholder="••••••••">
    <button class="btn-submit" style="background:linear-gradient(135deg,#EF4444,#DC2626)" onclick="adminLogin()">🔐 دخول لوحة التحكم</button>
    <button class="btn-back" onclick="closeAdmin()">إلغاء</button>`;
}

function adminLogin() {
  const e=document.getElementById('a_email').value.trim();
  const p=document.getElementById('a_pass').value;
  if(e===ADMIN.email&&p===ADMIN.password){ adminAuth=true; renderAdmin(); }
  else document.getElementById('adminErr').innerHTML=`<div class="error-box">⚠️ بيانات الدخول غير صحيحة</div>`;
}

function renderDashboard() {
  const pending=users.filter(u=>u.status==='pending');
  const approved=users.filter(u=>u.status==='approved');
  const rejected=users.filter(u=>u.status==='rejected');
  document.getElementById('adminContent').innerHTML = `
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
      <h3 style="color:#fff;margin:0;font-size:16px">📊 لوحة التحكم</h3>
      <button onclick="closeAdmin()" style="background:none;border:none;color:#888;font-size:20px;cursor:pointer">✕</button>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px">
      ${[['👥',users.length,'إجمالي','#3B82F6'],['✅',approved.length,'مقبول','#22c55e'],['⏳',pending.length,'انتظار','#F59E0B'],['❌',rejected.length,'مرفوض','#EF4444']].map(([ic,n,lb,c])=>`
      <div style="background:#1a1a2e;border:1px solid ${c}25;border-radius:12px;padding:14px;text-align:center">
        <div style="font-size:20px">${ic}</div>
        <div style="font-size:22px;font-weight:900;color:${c}">${n}</div>
        <div style="font-size:11px;color:#5a5a7a">${lb}</div>
      </div>`).join('')}
    </div>
    ${pending.length?`<div style="font-size:12px;color:#F59E0B;margin-bottom:10px;font-weight:700">⏳ يحتاجون موافقتك (${pending.length})</div>
    ${pending.slice(0,3).map(u=>`
    <div style="background:#1a1a2e;border:1px solid #F59E0B25;border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px">
      <div style="width:34px;height:34px;border-radius:50%;background:#3B82F620;border:1.5px solid #3B82F6;display:flex;align-items:center;justify-content:center;font-weight:700;color:#3B82F6;flex-shrink:0">${u.name.charAt(0)}</div>
      <div style="flex:1;min-width:0">
        <div style="font-weight:700;font-size:13px;color:#fff">${u.name}</div>
        <div style="font-size:11px;color:#5a5a7a;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${u.country}</div>
      </div>
      <button onclick="quickApprove(${u.id})" style="background:#22c55e20;border:1px solid #22c55e50;color:#22c55e;padding:5px 10px;border-radius:16px;font-size:11px;cursor:pointer;font-family:inherit">✅</button>
      <button onclick="quickReject(${u.id})"  style="background:#EF444415;border:1px solid #EF444440;color:#EF4444;padding:5px 10px;border-radius:16px;font-size:11px;cursor:pointer;font-family:inherit">❌</button>
    </div>`).join('')}`:''}
    <button onclick="adminView='users';renderAdmin()" style="width:100%;padding:11px;background:#3B82F620;border:1px solid #3B82F640;color:#3B82F6;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;margin-top:10px">👥 عرض جميع الطلاب</button>
    <button onclick="closeAdmin();adminAuth=false" style="width:100%;padding:9px;background:transparent;border:none;color:#EF4444;font-size:12px;cursor:pointer;font-family:inherit;margin-top:6px">🚪 تسجيل الخروج</button>`;
}

function renderUsersList() {
  document.getElementById('adminContent').innerHTML = `
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">
      <button onclick="adminView='dashboard';renderAdmin()" style="background:none;border:none;color:#888;font-size:20px;cursor:pointer">←</button>
      <h3 style="color:#fff;margin:0;font-size:15px">👥 جميع الطلاب (${users.length})</h3>
      <button onclick="closeAdmin()" style="background:none;border:none;color:#888;font-size:20px;cursor:pointer;margin-right:auto">✕</button>
    </div>
    ${users.length===0?'<div style="text-align:center;color:#5a5a7a;padding:30px">لا يوجد طلاب بعد</div>':
    users.map(u=>`
    <div onclick="selUser=JSON.parse(JSON.stringify(users.find(x=>x.id===${u.id})));renderAdmin()" style="display:flex;align-items:center;gap:10px;padding:12px 14px;background:#1a1a2e;border:1px solid #ffffff08;border-radius:12px;margin-bottom:8px;cursor:pointer">
      <div style="width:34px;height:34px;border-radius:50%;background:#3B82F620;border:1.5px solid #3B82F6;display:flex;align-items:center;justify-content:center;font-weight:700;color:#3B82F6;flex-shrink:0">${u.name.charAt(0)}</div>
      <div style="flex:1;min-width:0">
        <div style="font-weight:700;font-size:13px;color:#fff">${u.name}</div>
        <div style="font-size:11px;color:#5a5a7a;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${u.email}</div>
      </div>
      <span style="font-size:10px;padding:2px 8px;border-radius:20px;font-weight:700;${u.status==='approved'?'background:#22c55e18;color:#4ade80':u.status==='pending'?'background:#F59E0B18;color:#F59E0B':'background:#EF444415;color:#f87171'}">
        ${u.status==='approved'?'✅ مقبول':u.status==='pending'?'⏳ انتظار':'❌ مرفوض'}
      </span>
    </div>`).join('')}`;
}

function renderUserDetail() {
  const u = selUser;
  document.getElementById('adminContent').innerHTML = `
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">
      <button onclick="selUser=null;renderAdmin()" style="background:none;border:none;color:#888;font-size:20px;cursor:pointer">←</button>
      <h3 style="color:#fff;margin:0;font-size:15px">تفاصيل الطالب</h3>
      <button onclick="closeAdmin()" style="background:none;border:none;color:#888;font-size:20px;cursor:pointer;margin-right:auto">✕</button>
    </div>
    <div style="text-align:center;margin-bottom:18px">
      <div style="width:56px;height:56px;border-radius:50%;background:#3B82F620;border:2px solid #3B82F6;display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:700;color:#3B82F6;margin:0 auto 10px">${u.name.charAt(0)}</div>
      <div style="font-size:17px;font-weight:900;color:#fff">${u.name}</div>
    </div>
    ${[['📧','البريد',u.email],['🌍','الدولة',u.country],['🎂','العمر',u.age+' سنة'],['⭐','الخطة',u.plan],['📅','تاريخ',u.date]].map(([ic,lb,vl])=>`
    <div style="display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid #ffffff06;font-size:13px">
      <span style="color:#5a5a7a">${ic} ${lb}</span><span style="color:#fff;font-weight:600">${vl}</span>
    </div>`).join('')}
    <div style="display:flex;gap:8px;margin-top:16px">
      ${u.status!=='approved'?`<button onclick="approveUser(${u.id})" style="flex:1;padding:10px;background:#22c55e20;border:1px solid #22c55e50;color:#22c55e;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">✅ قبول</button>`:''}
      ${u.status!=='rejected'?`<button onclick="rejectUser(${u.id})" style="flex:1;padding:10px;background:#EF444420;border:1px solid #EF444450;color:#EF4444;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">❌ رفض</button>`:''}
    </div>
    <button onclick="deleteUser(${u.id})" style="width:100%;margin-top:8px;padding:9px;background:transparent;border:1px solid #ffffff15;color:#888;border-radius:10px;font-size:12px;cursor:pointer;font-family:inherit">🗑️ حذف نهائياً</button>`;
}

function quickApprove(id){ users=users.map(u=>u.id===id?{...u,status:'approved'}:u); saveUsers(); updateCount(); renderAdmin(); }
function quickReject(id){ users=users.map(u=>u.id===id?{...u,status:'rejected'}:u); saveUsers(); renderAdmin(); }
function approveUser(id){ users=users.map(u=>u.id===id?{...u,status:'approved'}:u); saveUsers(); updateCount(); selUser=null; renderAdmin(); }
function rejectUser(id){ users=users.map(u=>u.id===id?{...u,status:'rejected'}:u); saveUsers(); selUser=null; renderAdmin(); }
function deleteUser(id){ users=users.filter(u=>u.id!==id); saveUsers(); selUser=null; renderAdmin(); }

// close on outside click
document.getElementById('registerModal').addEventListener('click',function(e){if(e.target===this)closeRegister();});
document.getElementById('adminModal').addEventListener('click',function(e){if(e.target===this)closeAdmin();});
</script>
</body>
</html>
